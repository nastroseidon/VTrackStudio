{
  "name": "@vtrack/courseforge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "verify:fast": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify": "npm run verify:fast && npm run audit && npm run test:browser"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.5.5",
    "geotiff": "^3.0.5",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  }
}
